{
  "name": "mukallaf-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "مُكَلَّف - متابعة التكليفات والمصاريف والأرباح (نسخة ويندوز)",
  "main": "main.js",
  "scripts": {
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.mukallaf.app",
    "productName": "مُكَلَّف",
    "icon": "build/icon.ico",
    "asar": false,
    "files": [
      "main.js",
      "app/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "directories": {
      "output": "dist"
    }
  }
}
